package io.github.C0000374.HCl.Gui;

import io.github.C0000374.HCl.CClient;
import io.github.C0000374.HCl.BSE$MODOBJ;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.Iterator;
import net.minecraft.client.Minecraft;
import net.minecraft.src.GuiScreen;
import org.lwjgl.input.Keyboard;
import org.lwjgl.input.Mouse;

#include <HCL.INC>

#define CS_VALIDFLAGS   0

final class CLASSOBJ {
    public String ClassId;
    public ACWindowProcedure WindowProcedure;
    public int Flags;
}

#define WM_LEFTBUTTONDOWN   0
#define WM_RIGHTBUTTONDOWN  1
#define WM_LEFTBUTTONUP     2
#define WM_RIGHTBUTTONUP    3
#define WM_MOUSEMOVE        4
#define WM_KEYDOWN          0x20
#define WM_KEYUP            0x21
#define WM_PAINT            0x30
#define WM_CONTROL          0x31
#define WM_DESTROY          0x33
#define WM_CREATE           0x35

#define WS_CAPTION          1
#define WS_MINIMIZEBOX      2
#define WS_CLOSEBOX         4
#define WS_VALIDFLAGS   (WS_MINIMIZEBOX | WS_CAPTION | WS_CLOSEBOX)

final class WINDOWOBJ {
    public CLASSOBJ ClassObj;
    public int Width;
    public int Height;
    public int X;
    public int Y;
    public int hParent;
    public String Title;
    public int Flags;
    public ArrayList<Integer> hChildren;
    public boolean IsMinimized;
    public int OldHeight;
    public Object WindowData;
}

abstract class ACWindowProcedure {
    
    public CClickGui Services;
    
    public
    ACWindowProcedure(
        )
    {
        this.Services = CClickGui.Instance;
        return;
    }
    
    public
    abstract
    void
    WindowProcedure(
        int hWindow,
        int MessageId,
        Object wParam,
        Object lParam
        );
}

#define H2I(H) ((H) - 1)
#define I2H(I) ((I) + 1)

public final class CClickGui extends GuiScreen {
    
    public Minecraft MinecraftInstance;
    public HashMap<String, CLASSOBJ> WM$ClassList = new HashMap<>();
    public ArrayList<WINDOWOBJ> WM$WindowList = new ArrayList<>();
    public int WM$DrawX = 0;
    public int WM$DrawY = 0;
    public ArrayList<Integer> WM$ZList = new ArrayList<>(); 
    public int WM$LastMouseX = 0;
    public int WM$LastMouseY = 0;
    public boolean WM$HasFocusWindow = false;
    public boolean WM$IsDraggingWindow = false;
    public int WM$LastWindowX;
    public int WM$LastWindowY;
    public int WM$WindowToDrag;
    public static CClickGui Instance;
    public int WM$LastWindow = 0;
    
    public
    CClickGui(
        Minecraft MinecraftInstance
        )
    {
        Iterator<CCategory> I;
        CCategory Category;
        int Y;
        int hWindow;
        
        this.MinecraftInstance = MinecraftInstance;
        Instance = this;
        this.WM$RegisterClass("CToggleButton", new CToggleButton(), 0);
        this.WM$RegisterClass("CCategoryWindow", new CCategoryWindow(), 0);
        
        I = this.MinecraftInstance.Client.Categories.values().iterator();
        Y = 0;
        while (I.hasNext()) {
            Category = I.next();
            
            hWindow = this.WM$CreateWindow(
                Category.Id,
                "CCategoryWindow",
                WS_MINIMIZEBOX | WS_CAPTION,
                0,
                20,
                Y,
                100,
                16,
                Category
            );
            this.WM$MinimizeOrMaximizeWindow(hWindow);
            Y += 20;
        }
        return;
    }
    
    @Override
    public
    boolean
    doesGuiPauseGame(
        )
    {
        return false;
    }
    
    @Override
    public void
    drawScreen(
        int i0,
        int i1,
        float f0
        )
    {
        int i;
        
        super.drawScreen(i0, i1, f0);
        for (i = 0; i < this.WM$ZList.size(); i++) this.WM$DrawWindow(this.WM$ZList.get(i));
        return;
    }
    
    @Override
    public void
    handleKeyboardInput(
        )
    {
        int MessageId;
        int wParam;
        char lParam;
        WINDOWOBJ WindowObj;
        int hWindow;

        super.handleKeyboardInput();
        
        if (this.WM$ZList.size() == 0) return;
        if (!this.WM$HasFocusWindow) return;
        
        MessageId = Keyboard.getEventKeyState()? WM_KEYDOWN: WM_KEYUP;
        wParam = Keyboard.getEventKey();
        lParam = Keyboard.getEventCharacter();
        
        WindowObj = this.WM$WindowList.get(H2I(this.WM$ZList.get(this.WM$ZList.size() - 1)));
        if (WindowObj.IsMinimized) return;
        WindowObj.ClassObj.WindowProcedure.WindowProcedure(
            this.WM$ZList.get(this.WM$ZList.size() - 1),
            MessageId,
            wParam,
            lParam
        );
        
        while (WindowObj.hChildren.size() != 0) {
            
            hWindow = WindowObj.hChildren.get(WindowObj.hChildren.size() - 1);
            WindowObj = this.WM$WindowList.get(H2I(hWindow));
            if (WindowObj.IsMinimized) return;
            WindowObj.ClassObj.WindowProcedure.WindowProcedure(
                hWindow,
                MessageId,
                wParam,
                lParam
            );
        }
        return;
    }
    
    @Override
    public void
    handleMouseInput(
        )
    {
        int MouseX;
        int MouseY;
        int MessageId;
        int hWindow;
        WINDOWOBJ WindowObj;
        boolean bStatus;
        boolean IsBox1Pressed;
        boolean IsBox2Pressed;
        
        super.handleMouseInput();
        MouseX = Mouse.getEventX() * this.width / this.mc.displayWidth;
        MouseY = this.height - Mouse.getEventY() * this.height / this.mc.displayHeight - 1;
        
        if (Mouse.getEventButtonState()) 
            switch (Mouse.getEventButton()) {
            case 0:
                MessageId = WM_LEFTBUTTONDOWN;
                break;

            case 1:
                MessageId = WM_RIGHTBUTTONDOWN;
                break;

            default:
                return;
            }
        else switch (Mouse.getEventButton()) {
        case 0:
            MessageId = WM_LEFTBUTTONUP;
            break;

        case 1:
            MessageId = WM_RIGHTBUTTONUP;
            break;
            
        case -1:
            MessageId = WM_MOUSEMOVE;
            this.WM$LastMouseX = MouseX;
            this.WM$LastMouseY = MouseY;
            break;

        default:
            return;
        }
        
        if (!this.WM$IsDraggingWindow) {
            hWindow = this.WM$GetWindowByCoords(this.WM$LastMouseX, this.WM$LastMouseY);
        
            if (MessageId == WM_LEFTBUTTONDOWN || MessageId == WM_RIGHTBUTTONDOWN) this.WM$SetFocusWindow_Internal(hWindow);
            
            if (hWindow != this.WM$LastWindow) {
                if (this.WM$LastWindow != 0) this.WM$CallWindowProcedure(
                        this.WM$LastWindow,
                        WM_MOUSEMOVE,
                        -1,
                        -1
                    );
                this.WM$LastWindow = hWindow;
            }
        
            if (hWindow != 0) {
            
                WindowObj = this.WM$WindowList.get(H2I(hWindow));
                if ((WindowObj.Flags & WS_CAPTION) != 0) {
                    
                    IsBox1Pressed = this.WM$IsPointInRectangle(
                        this.WM$XCoordToLocal(this.WM$LastMouseX, hWindow),
                        this.WM$YCoordToLocal(this.WM$LastMouseY, hWindow),
                        WindowObj.Width - 30,
                        2,
                        12,
                        12
                    ) && MessageId == WM_LEFTBUTTONDOWN;
                    
                    IsBox2Pressed = this.WM$IsPointInRectangle(
                        this.WM$XCoordToLocal(this.WM$LastMouseX, hWindow),
                        this.WM$YCoordToLocal(this.WM$LastMouseY, hWindow),
                        WindowObj.Width - 14,
                        2,
                        12,
                        12
                    ) && MessageId == WM_LEFTBUTTONDOWN;
                    
                    if ((WindowObj.Flags & WS_CLOSEBOX) != 0 && (WindowObj.Flags & WS_MINIMIZEBOX) != 0) {
                        
                        if (IsBox1Pressed) {
                            
                            WindowObj.IsMinimized = !WindowObj.IsMinimized;
                            if (WindowObj.IsMinimized) {
                                WindowObj.OldHeight = WindowObj.Height;
                                WindowObj.Height = 16;
                            }
                            else WindowObj.Height = WindowObj.OldHeight;
                            return;
                        }
                        if (IsBox2Pressed) {
                            
                            this.WM$DestroyWindow(hWindow);
                            return;
                        }
                    }
                    else if ((WindowObj.Flags & WS_CLOSEBOX) != 0 && IsBox2Pressed) {
                        
                        this.WM$DestroyWindow(hWindow);
                        return;
                    }
                    else if ((WindowObj.Flags & WS_MINIMIZEBOX) != 0 && IsBox2Pressed) {

                        WindowObj.IsMinimized = !WindowObj.IsMinimized;
                        if (WindowObj.IsMinimized) {
                            WindowObj.OldHeight = WindowObj.Height;
                            WindowObj.Height = 16;
                        }
                        else WindowObj.Height = WindowObj.OldHeight;
                        return;
                    }
                    
                    bStatus = this.WM$IsPointInRectangle(
                        this.WM$XCoordToLocal(this.WM$LastMouseX, hWindow),
                        this.WM$YCoordToLocal(this.WM$LastMouseY, hWindow),
                        0,
                        0,
                        WindowObj.Width,
                        16
                    );
                    if (bStatus && MessageId == WM_LEFTBUTTONDOWN) {
                        this.WM$LastWindowX = this.WM$XCoordToLocal(this.WM$LastMouseX, hWindow);
                        this.WM$LastWindowY = this.WM$YCoordToLocal(this.WM$LastMouseY, hWindow);
                        this.WM$IsDraggingWindow = true;
                        this.WM$WindowToDrag = hWindow;
                    } 
                    else WindowObj.ClassObj.WindowProcedure.WindowProcedure(
                        hWindow,
                        MessageId,
                        this.WM$XCoordToLocal(this.WM$LastMouseX, hWindow),
                        this.WM$YCoordToLocal(this.WM$LastMouseY, hWindow) - 16
                    );
                }
                else WindowObj.ClassObj.WindowProcedure.WindowProcedure(
                    hWindow,
                    MessageId,
                    this.WM$XCoordToLocal(this.WM$LastMouseX, hWindow),
                    this.WM$YCoordToLocal(this.WM$LastMouseY, hWindow)
                );
            }
        }
        else switch (MessageId) {
        case WM_LEFTBUTTONUP:
            this.WM$IsDraggingWindow = false;
            break;

        case WM_MOUSEMOVE:
            this.WM$MoveWindow_A(
                this.WM$WindowToDrag,
                this.WM$LastMouseX - this.WM$LastWindowX,
                this.WM$LastMouseY - this.WM$LastWindowY
            );
            break;

        default:
            return;
        }
        return;
    }
    
    //++
    //
    // win mgr
    //
    //--
    
    public
    boolean
    WM$RegisterClass(
        String ClassId,
        ACWindowProcedure WindowProcedure,
        int Flags
        )
    {
        CLASSOBJ ClassObj;
        
        if ((Flags & ~CS_VALIDFLAGS) != 0) return false;
        
        ClassId = ClassId.toUpperCase();
        if (this.WM$ClassList.get(ClassId) != null) return false;
        
        ClassObj = new CLASSOBJ();
        ClassObj.ClassId = ClassId;
        ClassObj.WindowProcedure = WindowProcedure;
        ClassObj.Flags = Flags;
        
        this.WM$ClassList.put(ClassId, ClassObj);
        return true;
    }
    
    public
    int
    WM$CreateWindow(
        String Title,
        String ClassId,
        int Flags,
        int hParent,
        int X,
        int Y,
        int Width,
        int Height,
        Object lParam
        )
    {
        WINDOWOBJ WindowObj;
        CLASSOBJ ClassObj;
        int hWindow;
        int i;
        
        ClassId = ClassId.toUpperCase();
        if ((Flags & ~WS_VALIDFLAGS) != 0) return 0;
        
        ClassObj = this.WM$ClassList.get(ClassId);
        if (ClassObj == null) return 0;
        
        WindowObj = new WINDOWOBJ();
        WindowObj.ClassObj = ClassObj;
        WindowObj.Width = Width;
        WindowObj.Height = Height;
        WindowObj.X = X;
        WindowObj.Y = Y;
        WindowObj.hParent = hParent;
        WindowObj.Title = Title;
        WindowObj.Flags = Flags;
        WindowObj.hChildren = new ArrayList<Integer>();
        WindowObj.IsMinimized = false;
        WindowObj.WindowData = null;
        
        hWindow = 0;
        for (i = 0; i < this.WM$WindowList.size(); i++) 
            if (this.WM$WindowList.get(i) == null) {
            
                this.WM$WindowList.set(i, WindowObj);
                hWindow = I2H(i);
                break;
            }
        if (hWindow == 0) {
            this.WM$WindowList.add(WindowObj);
            hWindow = I2H(i);
        }
        
        if (hParent != 0) this.WM$WindowList.get(H2I(hParent)).hChildren.add(hWindow);
        else this.WM$ZList.add(hWindow);
        ClassObj.WindowProcedure.WindowProcedure(hWindow, WM_CREATE, null, lParam);
        return hWindow;
    }
    
    public
    void
    WM$DrawWindow(
        int hWindow
        )
    {
        WINDOWOBJ WindowObj;
        int i;
        
        WindowObj = this.WM$WindowList.get(H2I(hWindow));
        this.WM$DrawX = 0;
        this.WM$DrawY = 0;
        this.WM$GetDrawCoords(WindowObj);

        if ((WindowObj.Flags & WS_CAPTION) != 0) {

            this.WM$DrawRectangle(0, 0, WindowObj.Width, 16, 0xFFFF0000);
            this.WM$DrawString(WindowObj.Title, 4, 4, 0xFFFFFF);

            if ((WindowObj.Flags & WS_CLOSEBOX) != 0 && (WindowObj.Flags & WS_MINIMIZEBOX) != 0) {

                this.WM$DrawRectangle(WindowObj.Width - 14, 2, WindowObj.Width - 2, 14, 0xFF000000);
                this.WM$DrawString("x", WindowObj.Width - 11, 4, 0xFFFFFF);
                this.WM$DrawRectangle(WindowObj.Width - 30, 2, WindowObj.Width - 18, 14, 0xFF000000);
                this.WM$DrawString("-", WindowObj.Width - 27, 4, 0xFFFFFF);
            }
            else if ((WindowObj.Flags & WS_CLOSEBOX) != 0) {

                this.WM$DrawRectangle(WindowObj.Width - 14, 2, WindowObj.Width - 2, 14, 0xFF000000);
                this.WM$DrawString("x", WindowObj.Width - 11, 4, 0xFFFFFF);
            }
            else if ((WindowObj.Flags & WS_MINIMIZEBOX) != 0) {

                this.WM$DrawRectangle(WindowObj.Width - 14, 2, WindowObj.Width - 2, 14, 0xFF000000);
                this.WM$DrawString("-", WindowObj.Width - 11, 4, 0xFFFFFF);
            }

            if (WindowObj.IsMinimized) return;
            this.WM$DrawY += 16;
            this.WM$DrawGradientRectangle(0, 0, WindowObj.Width, WindowObj.Height - 16, -1072689136, -804253680);
        }

        WindowObj.ClassObj.WindowProcedure.WindowProcedure(hWindow, WM_PAINT, null, null);
        
        for (i = 0; i < WindowObj.hChildren.size(); i++) this.WM$DrawWindow(WindowObj.hChildren.get(i));
        return;
    }
    
    public
    void
    WM$GetDrawCoords(
        WINDOWOBJ WindowObj
        )
    {        
        this.WM$DrawX += WindowObj.X;
        this.WM$DrawY += WindowObj.Y;
        if (WindowObj.hParent != 0)
            this.WM$GetDrawCoords(this.WM$WindowList.get(H2I(WindowObj.hParent)));
        return;
    }
    
    public
    void
    WM$DrawHorizontalLine(
        int X1,
        int X2,
        int Y,
