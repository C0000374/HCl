    public
    int
    WM$GetFocusWindow(
        )
    {
        return this.WM$ZList.get(this.WM$ZList.size() - 1);
    }
    
    public
    void
    WM$SetFocusWindow_Internal(
        int hWindow
        )
    {
        WINDOWOBJ WindowObj;
        WINDOWOBJ ParentWindowObj;
        int i;
        
        if (hWindow == 0) this.WM$HasFocusWindow = false;
        else {
            WindowObj = this.WM$WindowList.get(H2I(hWindow));
            
            if (WindowObj.hParent == 0) {
            
                for (i = 0; i < this.WM$ZList.size(); i++) if (this.WM$ZList.get(i) == hWindow) break;
                for (; i < this.WM$ZList.size() - 1; i++) this.WM$ZList.set(i, this.WM$ZList.get(i + 1));
                this.WM$ZList.set(i, hWindow);
            }
            else {
                ParentWindowObj = this.WM$WindowList.get(H2I(WindowObj.hParent));
                for (i = 0; i < ParentWindowObj.hChildren.size(); i++) if (ParentWindowObj.hChildren.get(i) == hWindow) break;
                for (; i < ParentWindowObj.hChildren.size() - 1; i++) ParentWindowObj.hChildren.set(i, ParentWindowObj.hChildren.get(i + 1));
                ParentWindowObj.hChildren.set(i, hWindow);
                this.WM$SetFocusWindow_Internal(WindowObj.hParent);
            }
            
            this.WM$HasFocusWindow = true;
        }
        return;
    }
    
    public
    void
    WM$SetFocusWindow(
        int hWindow
        )
    {
        if (hWindow == 0) this.WM$HasFocusWindow = false;
        if (this.WM$WindowList.get(H2I(hWindow)).hParent == 0) this.WM$SetFocusWindow_Internal(hWindow);
        return;
    }
    
    public
    boolean
    WM$IsPointInRectangle(
        int PointX,
        int PointY,
        int RectangleX,
        int RectangleY,
        int RectangleWidth,
        int RectangleHeight
        )
    {
        if (PointX >= RectangleX && PointY >= RectangleY && PointX < (RectangleX + RectangleWidth) && PointY < (RectangleY + RectangleHeight)) return true;
        return false;
    }
    
    public
    boolean
    WM$IsPointInWindow(
        int PointX,
        int PointY,
        int hWindow
        )
    {
        WINDOWOBJ WindowObj;
        
        WindowObj = this.WM$WindowList.get(H2I(hWindow));
        return WM$IsPointInRectangle(
            PointX,
            PointY,
            WindowObj.X,
            WindowObj.Y,
            WindowObj.Width,
            WindowObj.Height
        );
    }
    
    public
    int
    WM$GetWindowByCoords_Internal(
        int hParent,
        int X,
        int Y
        )
    {
        WINDOWOBJ ParentWindowObj;
        WINDOWOBJ ChildWindowObj;
        int i;
        boolean bStatus;
        int hWindow;
        
        ParentWindowObj = this.WM$WindowList.get(H2I(hParent));
        if (ParentWindowObj.hChildren.size() == 0) return hParent;
        
        for (i = ParentWindowObj.hChildren.size() - 1; i >= 0; i--) {
            
            hWindow = ParentWindowObj.hChildren.get(i);
            ChildWindowObj = this.WM$WindowList.get(H2I(hWindow));
            
            bStatus = this.WM$IsPointInRectangle(
                X,
                Y,
                ChildWindowObj.X,
                ChildWindowObj.Y,
                ChildWindowObj.Width,
                ChildWindowObj.Height
            );
            if (bStatus) return this.WM$GetWindowByCoords_Internal(hWindow, X - ChildWindowObj.X, Y - ChildWindowObj.Y);
        }
        
        return hParent;
    }
    
    public
    int
    WM$GetWindowByCoords(
        int X,
        int Y
        )
    {
        WINDOWOBJ WindowObj;
        int i;
        boolean bStatus;
        int hWindow;
        
        if (this.WM$ZList.size() == 0) return 0;
        
        for (i = this.WM$ZList.size() - 1; i >= 0; i--) {
            
            hWindow = this.WM$ZList.get(i);
            WindowObj = this.WM$WindowList.get(H2I(hWindow));
            
            bStatus = this.WM$IsPointInRectangle(
                X,
                Y,
                WindowObj.X,
                WindowObj.Y,
                WindowObj.Width,
                WindowObj.Height
            );
            if (bStatus) return this.WM$GetWindowByCoords_Internal(hWindow, X - WindowObj.X, Y - WindowObj.Y);
        }
        
        return 0;
    }
    
    public
    int
    WM$XCoordToLocal(
        int X,
        int hWindow
        )
    {
        WINDOWOBJ WindowObj;
        
        WindowObj = this.WM$WindowList.get(H2I(hWindow));
        X -= WindowObj.X;
        while (WindowObj.hParent != 0) {
            WindowObj = this.WM$WindowList.get(H2I(WindowObj.hParent));
            X -= WindowObj.X;
        }
        
        return X;
    }
    
    public
    int
    WM$YCoordToLocal(
        int Y,
        int hWindow
        )
    {
        WINDOWOBJ WindowObj;
        
        WindowObj = this.WM$WindowList.get(H2I(hWindow));
        Y -= WindowObj.Y;
        while (WindowObj.hParent != 0) {
            WindowObj = this.WM$WindowList.get(H2I(WindowObj.hParent));
            Y -= WindowObj.Y;
        }
        
        return Y;
    }
    
    public
    void
    WM$MoveWindow_D(
        int hWindow,
        int dX,
        int dY
        )
    {
        WINDOWOBJ WindowObj;
        
        WindowObj = this.WM$WindowList.get(H2I(hWindow));
        WindowObj.X += dX;
        WindowObj.Y += dY;
        return;
    }
    
    public
    void
    WM$MoveWindow_A(
        int hWindow,
        int X,
        int Y
        )
    {
        WINDOWOBJ WindowObj;
        
        WindowObj = this.WM$WindowList.get(H2I(hWindow));
        WindowObj.X = X;
        WindowObj.Y = Y;
        return;
    }
    
    public
    void
    WM$DestroyWindow(
        int hWindow
        )
    {
        WINDOWOBJ WindowObj;
        WINDOWOBJ ParentWindowObj;
        int i;
        int Size;
        
        WindowObj = this.WM$WindowList.get(H2I(hWindow));
        WindowObj.ClassObj.WindowProcedure.WindowProcedure(hWindow, WM_DESTROY, null, null);
        for (i = 0, Size = WindowObj.hChildren.size(); i < Size; i++) this.WM$DestroyWindow(WindowObj.hChildren.get(0));
        this.WM$WindowList.set(H2I(hWindow), null);
        if (WindowObj.hParent == 0) {
            
            for (i = 0; i < this.WM$ZList.size(); i++) if (this.WM$ZList.get(i) == hWindow) break;
            this.WM$ZList.remove(i);
        }
        else {
            
            ParentWindowObj = this.WM$WindowList.get(H2I(hWindow));
            for (i = 0; i < ParentWindowObj.hChildren.size(); i++) if (ParentWindowObj.hChildren.get(i) == hWindow) break;
            ParentWindowObj.hChildren.remove(i);
        }
        return;
    }
    
    public
    Object
    WM$GetWindowData(
        int hWindow
        )
    {
        return this.WM$WindowList.get(H2I(hWindow)).WindowData;
    }
    
    public
    void
    WM$SetWindowData(
        int hWindow,
        Object WindowData
        )
    {
        this.WM$WindowList.get(H2I(hWindow)).WindowData = WindowData;
        return;
    }
    
    public
    void
    WM$CallWindowProcedure(
        int hWindow,
        int MessageId,
        Object wParam,
        Object lParam
        )
    {
        this.WM$WindowList.get(H2I(hWindow)).ClassObj.WindowProcedure.WindowProcedure(hWindow, MessageId, wParam, lParam);
        return;
    }
    
    public
    int
    WM$GetParentWindow(
        int hWindow
        )
    {
        return this.WM$WindowList.get(H2I(hWindow)).hParent;
    }
    
    public
    void
    WM$ResizeWindow(
        int hWindow,
        int Width,
        int Height
        )
    {
        WINDOWOBJ WindowObj;
        
        WindowObj = this.WM$WindowList.get(H2I(hWindow));
        WindowObj.Width = Width;
        WindowObj.Height = Height;
        return;
    }
    
    public
    void
    WM$MinimizeOrMaximizeWindow(
        int hWindow
        )
    {
        WINDOWOBJ WindowObj;
        
        WindowObj = this.WM$WindowList.get(H2I(hWindow));
        
        WindowObj.IsMinimized = !WindowObj.IsMinimized;
        if (WindowObj.IsMinimized) {
            WindowObj.OldHeight = WindowObj.Height;
            WindowObj.Height = 16;
        }
        else WindowObj.Height = WindowObj.OldHeight;
        return;
    }
}

final class CToggleButton_Data {
    public BSE$MODOBJ Module;
    public boolean IsRed;
}

final class CToggleButton extends ACWindowProcedure {
    
    @Override
    public
    void
    WindowProcedure(
        int hWindow,
        int MessageId,
        Object wParam,
        Object lParam
        )
    {
        CToggleButton_Data Data;
        Integer MouseX;
        Integer MouseY;
        int Color;
        
        switch (MessageId) {
        case WM_CREATE:
            Data = new CToggleButton_Data();
            Data.Module = (BSE$MODOBJ)lParam;
            Data.IsRed = false;
            this.Services.WM$SetWindowData(hWindow, Data);
            break;
            
        case WM_PAINT:
            Data = (CToggleButton_Data)this.Services.WM$GetWindowData(hWindow);
            if (Data.IsRed) Color = 0x00FF0000;
            else Color = 0x00FFFFFF;
            this.Services.WM$DrawString(Data.Module.Id, 4, 2, Color);
            if (Data.Module.IsActive) this.Services.WM$DrawRectangle(0, 0, 2, 12, 0xFFFFFFFF);
            break;
            
        case WM_MOUSEMOVE:
            Data = (CToggleButton_Data)this.Services.WM$GetWindowData(hWindow);
            MouseX = (Integer)wParam;
            MouseY = (Integer)lParam;
            Data.IsRed = MouseX > 0 && MouseY > 0;
            break;
            
        case WM_LEFTBUTTONDOWN:
            MouseX = (Integer)wParam;
            MouseY = (Integer)lParam;
            Data = (CToggleButton_Data)this.Services.WM$GetWindowData(hWindow);
            CClient.BSE$ClientInstance.BSE$ToggleModule(Data.Module);
            break;
        }
        return;
    }
}

final class CCategoryWindow extends ACWindowProcedure {
    
    @Override
    public
    void
    WindowProcedure(
        int hWindow,
        int MessageId,
        Object wParam,
        Object lParam
        )
    {
        CCategory Category;
        int MaxWidth;
        int I;
        int Width;
        
        switch (MessageId) {
        case WM_CREATE:
            this.Services.WM$SetWindowData(hWindow, lParam);
            
            Category = (CCategory)lParam;
            MaxWidth = 100;
            for (I = 0; I < Category.Modules.length; I++) {
                Width = this.Services.MinecraftInstance.fontRenderer.getStringWidth(Category.Modules[I].Id) + 4 + 2;
                if (Width > MaxWidth) MaxWidth = Width;
            }
            this.Services.WM$ResizeWindow(
                hWindow,
                MaxWidth,
                16 + Category.Modules.length * 12
            );
            
            for (I = 0; I < Category.Modules.length; I++)
                this.Services.WM$CreateWindow(
                    "",
                    "CToggleButton",
                    0,
                    hWindow,
                    0,
                    16 + I * 12,
                    MaxWidth,
                    12,
                    Category.Modules[I]
                );
            break;
        }
        return;
    }
}